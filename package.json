{
  "name": "overlays-server",
  "version": "0.1.1",
  "description": "Local telemetry bridge for stream overlays: reads live GPS from dashcams (DDPAI, ...) and serves it to browser-source overlays over WebSocket / SSE.",
  "license": "AGPL-3.0-or-later",
  "author": "Ramazan Sancar",
  "homepage": "https://github.com/ramazansancar/overlays-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramazansancar/overlays-server.git"
  },
  "bugs": {
    "url": "https://github.com/ramazansancar/overlays-server/issues"
  },
  "keywords": [
    "obs",
    "overlay",
    "gps",
    "dashcam",
    "ddpai",
    "irl",
    "stream"
  ],
  "type": "module",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "overlays-server": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README-tr.md",
    "config.example.json",
    "docs"
  ],
  "scripts": {
    "dev": "node --watch scripts/dev.ts",
    "dev:fake-camera": "node scripts/fake-ddpai.ts",
    "dev:server": "node --watch scripts/dev.ts --external",
    "dev:camera": "node --watch src/cli.ts",
    "start": "node src/cli.ts",
    "simulate": "node src/cli.ts --simulate",
    "fake-ddpai": "node scripts/fake-ddpai.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check:all": "pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
